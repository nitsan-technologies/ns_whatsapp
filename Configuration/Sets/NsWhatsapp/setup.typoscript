@import 'EXT:ns_whatsapp/Configuration/TypoScript/setup.typoscript'

plugin {
    tx_nswhasapp_whatsapp {
        settings {
            is_enable = {$ns_whatsapp.chat.isEnable}
            whatsapp_number = {$ns_whatsapp.chat.whatsappNumber}
            pre_filled_message = {$ns_whatsapp.chat.preFilledMessage}
            style_desktop = Style1
            style_mobile = Style1
            position = {$ns_whatsapp.chat.position}
            web_whatsapp = {$ns_whatsapp.chat.webWhatsapp}
            hide_pages = {$ns_whatsapp.chat.hidePages}
            hide_mobile = {$ns_whatsapp.chat.hideMobile}
            hide_desktop = {$ns_whatsapp.chat.hideDesktop}
            style1_text = {$ns_whatsapp.style.style1Text}
            style1_textcolor = {$ns_whatsapp.style.style1TextColor}
            style1_bgcolor = {$ns_whatsapp.style.style1BackgroundColor}
            style1_border = {$ns_whatsapp.style.style1BorderWidth}
            style1_bordercolor = {$ns_whatsapp.style.style1BorderColor}
            style1_htextcolor = {$ns_whatsapp.style.style1HoverTextColor}
            style1_hbgcolor = {$ns_whatsapp.style.style1HoverBackgroundColor}
            style1_hbordercolor = {$ns_whatsapp.style.style1HoverBorderColor}
        }
        view {
            templateRootPaths {
                10 = {$ns_whatsapp.view.templateRootPath}
            }
            partialRootPaths {
                10 = {$ns_whatsapp.view.partialRootPath}
            }
            layoutRootPaths {
                10 = {$ns_whatsapp.view.layoutRootPath}
            }
        }
    }
}

# Re-copy after Site Set overrides so USER cObject gets the final settings
page.111246.settings < plugin.tx_nswhasapp_whatsapp.settings
